# ONE shared set of keys for the whole team. Copy to .env (never commit .env).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST mode only (sk_test_...). Setup: packages/payments/README.md
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PROFILE_ID=
STRIPE_WEBHOOK_SECRET=
# spt (Shared Payment Tokens) or test_card (Fallback A). `pnpm stripe:smoke` tells you which.
STRIPE_PAYMENT_MODE=spt

# LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ports / URLs (match PORTS in packages/shared)
DASHBOARD_PORT=3000
SELLER_MCP_PORT=3001
MARKETPLACE_PORT=3002
SELLER_MCP_BASE_URL=http://localhost:3001/mcp
MARKETPLACE_URL=http://localhost:3002
