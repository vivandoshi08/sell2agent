{
  "name": "@sa/dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test test/*.test.ts",
    "seed:fake": "tsx --env-file-if-exists=../../.env scripts/seed-fake.ts",
    "seed:fake:clean": "tsx --env-file-if-exists=../../.env scripts/seed-fake.ts --clean",
    "preview:html": "node scripts/build-preview.mjs",
    "run-result": "tsx --env-file-if-exists=../../.env scripts/run-result.ts",
    "eval": "tsx --env-file-if-exists=../../.env scripts/eval.ts",
    "preview:html:eval": "node scripts/build-preview.mjs --local"
  },
  "dependencies": {
    "@sa/buyer-harness": "workspace:*",
    "@sa/seller-mcp": "workspace:*",
    "@sa/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.2"
  }
}
