{
  "name": "sales-agent",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev:seller": "pnpm --filter @sa/seller-mcp dev",
    "dev:marketplace": "pnpm --filter @sa/marketplace dev",
    "dev:dashboard": "pnpm --filter @sa/dashboard dev",
    "run:buyers": "pnpm --filter @sa/buyer-harness buyers",
    "smoke": "tsx scripts/smoke.ts",
    "stripe:smoke": "pnpm --filter @sa/payments smoke",
    "test:payments": "pnpm --filter @sa/payments test",
    "e2:gate": "pnpm --filter @sa/buyer-harness e2:gate",
    "test:sellers": "pnpm --filter @sa/seller-mcp test",
    "buyers": "pnpm --filter @sa/buyer-harness buyers",
    "e2:lever-gate": "pnpm --filter @sa/buyer-harness e2:lever-gate",
    "e2:bandit": "pnpm --filter @sa/buyer-harness e2:bandit"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
